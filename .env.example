# ====================================================================
# DS PROJECTS — Environment Configuration Template
# ====================================================================

# 1. Supabase PostgreSQL & Storage Configuration (Frontend + Backend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Supabase Service Role Key (Backend Only - Never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. SMTP Email Configuration (Nodemailer Backend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hr@dsprojects.in
SMTP_PASSWORD=your-app-password-here
EMAIL_FROM="DS PROJECTS HR Team <hr@dsprojects.in>"

# 4. App Base URL
VITE_APP_URL=https://dsprojects.in
